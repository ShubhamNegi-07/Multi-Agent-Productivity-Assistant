# ============================================================
#  Multi-Agent Assistant — Environment Template
# ============================================================
#
# Copy this file to `.env` and fill in your own keys:
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# Google Gemini — powers reasoning and response generation for all 8 agents.
# Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# OpenWeatherMap — used only by the Weather Agent for live conditions and
# forecasts. The other 7 agents work without it.
# Free tier at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here
